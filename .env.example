# Copy to .env and edit. Real environment variables win over this file.
# AWS credentials are NOT configured here: boto3 and the AWS CLI read them
# from ~/.aws (credentials, config, SSO cache). Never put keys in this file.

# --- Which vLLM server the lessons talk to ---------------------------------
# Default: a local port. `make live-forward` tunnels the AWS instance to it.
VLLM_BASE_URL=http://127.0.0.1:8000
# Only for servers started with --api-key. Leave empty for the AWS instance
# (it listens on localhost and is reached through an SSM tunnel).
VLLM_API_KEY=
# Model name sent in requests. Empty = the first model the server reports.
VLLM_MODEL=

# --- AWS GPU instance (tools/aws_gpu.py) -----------------------------------
# Optional: pick a named profile from ~/.aws/config. Empty = default profile.
AWS_PROFILE=
# Optional: empty = the profile's region (~/.aws/config).
AWS_REGION=
# Smallest single-GPU instance that vLLM supports: NVIDIA T4, 16 GB, 4 vCPU.
VLLM_INSTANCE_TYPE=g4dn.xlarge
# Hugging Face model served on the instance (ungated by default).
VLLM_SERVE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Pinned vLLM container image.
VLLM_IMAGE=vllm/vllm-openai:v0.33.0
# Extra arguments appended to the vLLM server command line.
VLLM_SERVER_ARGS=
# The instance shuts itself down (and is terminated) after this many hours.
VLLM_AUTO_TERMINATE_HOURS=4
# 1 = request a Spot instance (about half the price, can be interrupted).
VLLM_USE_SPOT=0
# Root volume size in GB (the vLLM image alone is over 20 GB).
VLLM_VOLUME_GB=100
# Optional: reuse an existing instance profile that has AmazonSSMManagedInstanceCore
# instead of letting the tool create one.
VLLM_INSTANCE_PROFILE=

# --- Secrets ---------------------------------------------------------------
# Only needed for gated Hugging Face models. A dedicated name on purpose: an
# ambient HF_TOKEN in your shell is never sent to AWS. Stored there as an
# encrypted SSM parameter, never in the instance's user data.
VLLM_HF_TOKEN=

# --- Safety latch for deleting remote resources ----------------------------
# `aws_gpu.py down` / `purge` refuse to run unless this is exactly
# "terminate" / "purge". Set it on the command line, not here:
#   VLLM_PRIMER_CONFIRM=terminate make clean-remote INSTANCE=i-0123456789abcdef0
