{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeImages",
        "ec2:DescribeSpotPriceHistory",
        "servicequotas:GetServiceQuota",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<REGION>"
        }
      }
    },
    {
      "Sid": "PriceListIsOnlyInUsEast1",
      "Effect": "Allow",
      "Action": "pricing:GetProducts",
      "Resource": "*"
    },
    {
      "Sid": "ResolveTheDeepLearningAmi",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:<REGION>::parameter/aws/service/deeplearning/ami/*"
    },
    {
      "Sid": "SecurityGroupCreateAndTag",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/*"
      ]
    },
    {
      "Sid": "TagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateSecurityGroup",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "DeleteOnlyOurSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "vllm-primer"
        }
      }
    },
    {
      "Sid": "LaunchOnlyTaggedSmallGpuInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "vllm-primer"
        },
        "StringLike": {
          "ec2:InstanceType": [
            "g4dn.xlarge",
            "g5.xlarge",
            "g6.xlarge"
          ]
        }
      }
    },
    {
      "Sid": "LaunchSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:<REGION>::image/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:volume/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:network-interface/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:spot-instances-request/*"
      ]
    },
    {
      "Sid": "TerminateOnlyOurInstances",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "vllm-primer"
        }
      }
    },
    {
      "Sid": "PassOnlyTheSsmRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/vllm-primer-ssm",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageOnlyTheOneRoleAndProfile",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:CreateRole",
        "iam:TagRole",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRole",
        "iam:CreateInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:DeleteInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/vllm-primer-ssm",
        "arn:aws:iam::<ACCOUNT_ID>:instance-profile/vllm-primer-ssm"
      ]
    },
    {
      "Sid": "AttachOnlyTheSsmManagedPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/vllm-primer-ssm",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "SpotServiceLinkedRoleOnFirstUse",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/spot.amazonaws.com/AWSServiceRoleForEC2Spot",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "spot.amazonaws.com"
        }
      }
    },
    {
      "Sid": "HuggingFaceTokenParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/vllm-primer/hf-token"
    },
    {
      "Sid": "RunShellDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:<REGION>::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "RunShellOnlyOnOurInstances",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "vllm-primer"
        }
      }
    },
    {
      "Sid": "TunnelDocument",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ssm:<REGION>::document/AWS-StartPortForwardingSession"
      ]
    },
    {
      "Sid": "TunnelOnlyOnOurInstances",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "vllm-primer"
        }
      }
    },
    {
      "Sid": "EndOwnTunnels",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/${aws:userid}-*"
    }
  ]
}
